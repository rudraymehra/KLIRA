# ===========================================
# Klira Server Environment Variables
# Copy to .env and fill in your values
# ===========================================

# REQUIRED: Solana RPC URL (Helius recommended for compressed account support)
# Get one at https://www.helius.dev/
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# REQUIRED: Server payer keypair (JSON array of secret key bytes)
# This wallet pays for fill/expire transactions and must be funded with SOL
# Generate with: solana-keygen new --outfile payer.json
# Then paste the contents here
KEY=[1,2,3,...your_secret_key_bytes]

# REQUIRED: API key for authenticating internal endpoints (/fill, /expired)
# Generate a random string: openssl rand -hex 32
KEEPER_API_KEY=your_random_api_key_here

# OPTIONAL: Telegram bot alerts
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# OPTIONAL: Klira invite code generation
KLIRA_CODE_PASSWORD=your_code_password
KLIRA_CODE_CREATED_BY=your_user_id

# OPTIONAL: CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://app.klira.xyz

# OPTIONAL: Server URL for Telegram bot commands (default: http://localhost:4000)
SERVER_URL=http://localhost:4000

# OPTIONAL: Matching engine URL for Telegram status checks (default: http://localhost:4001)
MATCHING_ENGINE_URL=http://localhost:4001

# REQUIRED for docker-compose: PostgreSQL password
POSTGRES_PASSWORD=change_me_to_a_strong_password

# OPTIONAL: Database URL for PostgreSQL (falls back to JSON file if unset)
# DATABASE_URL=postgresql://klira:klira@localhost:5432/klira

# OPTIONAL: Redis URL for job queues (include password to match docker-compose requirepass)
# REDIS_URL=redis://:changeme@localhost:6379

# OPTIONAL: Redis password (used by docker-compose redis requirepass)
REDIS_PASSWORD=changeme

# OPTIONAL: Log level (default: info)
LOG_LEVEL=info

# OPTIONAL: Node environment
NODE_ENV=production

# OPTIONAL: Server port (default: 4000)
PORT=4000

# OPTIONAL: Keeper interval in milliseconds (default: 15000)
KEEPER_INTERVAL_MS=15000

# OPTIONAL: Test RPC URLs (for running anchor tests)
# Get API keys at https://www.helius.dev/
# TEST_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# TEST_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
