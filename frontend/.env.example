# ===========================================
# Klira Frontend Environment Variables
# Copy to .env.local and fill in your values
# ===========================================

# WARNING: NEXT_PUBLIC_ variables are embedded in the client-side bundle.
# Do NOT put API keys directly in NEXT_PUBLIC_SOLANA_RPC_URL.
# Use a server-side proxy instead for production.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# REQUIRED: Network (devnet | mainnet-beta)
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# REQUIRED: Klira server URL (for order registration with the keeper)
NEXT_PUBLIC_API_URL=http://localhost:4000

# OPTIONAL: App version displayed in footer (default: v1.0.0)
NEXT_PUBLIC_APP_VERSION=v1.0.0
